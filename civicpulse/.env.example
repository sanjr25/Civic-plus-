# ==============================================================================
# CivicPulse Environment Configuration (.env.example)
# Copy this file to .env or .env.local and populate with your credentials.
# Note: All live credentials are kept strictly out of Git version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth Credentials
# ------------------------------------------------------------------------------
# Get from: https://supabase.com -> Select Project -> Project Settings -> API
# NEXT_PUBLIC_SUPABASE_URL: Project URL (e.g., https://xyzcompany.supabase.co)
# NEXT_PUBLIC_SUPABASE_ANON_KEY: anon / public API key (safe for browser)
# SUPABASE_SERVICE_ROLE_KEY: service_role key (server-only, optional for admin tasks)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. MongoDB Database Credentials
# ------------------------------------------------------------------------------
# Used for user CRUD management, chat conversation logs, and citizen feedback.
# Get from: https://cloud.mongodb.com -> Database -> Connect -> Connect your application
# Standard SRV connection string format:
# mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=civicpulse_db

# ------------------------------------------------------------------------------
# 3. Google Gemini AI API Key
# ------------------------------------------------------------------------------
# Used by CivicPulse AI Assistant for answering municipal FAQs, explaining error codes,
# and routing unresolved issues to official support tickets.
# Get from: https://aistudio.google.com/app/apikey -> "Create API Key"
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. Application Environment & Operational Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
